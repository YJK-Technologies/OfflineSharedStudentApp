# React CRA Environment Variables (must be prefixed with REACT_APP_)

# Default API URL for Windows Desktop (Electron) and Web Browser testing
REACT_APP_API_URL=http://localhost:5000

# Android Emulator API URL (Android emulator maps 10.0.2.2 to the host development PC)
# For physical Android phones, replace with your local WiFi IP (e.g. http://192.168.1.100:5000)
REACT_APP_ANDROID_API_URL=http://10.0.2.2:5000

# Auto Sync Interval in milliseconds (default: 30000 = 30 seconds)
REACT_APP_SYNC_INTERVAL_MS=30000
