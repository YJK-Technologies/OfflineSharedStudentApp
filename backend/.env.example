# Central SQLite Backend Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Path to SQLite database file
# In development, central_students.db will be created in backend folder
DATABASE_FILE=./central_students.db

# JWT Secret for authenticating client applications (Windows Desktop & Android Mobile)
JWT_SECRET=student_management_super_secure_jwt_secret_change_in_production_2026
JWT_EXPIRATION=7d

# CORS Allowed Origins
# In dev: allows CRA React dev server (http://localhost:3000), Electron (null/file://), Capacitor (capacitor://localhost)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,http://localhost

# Conflict Resolution Strategy: "LWW" (Last-Write-Wins) or "SERVER_VERSION_STRICT"
CONFLICT_STRATEGY=LWW
