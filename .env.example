# Root Environment Configuration for Offline-First Shared Student Application

# Backend Port
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000

# React Frontend Development Server Port
PORT=3000

# Android Emulator uses 10.0.2.2 to connect to host computer's localhost
REACT_APP_API_URL=http://localhost:5000
REACT_APP_ANDROID_EMULATOR_API_URL=http://10.0.2.2:5000

# Central SQLite Database Path
DATABASE_FILE=./backend/central_students.db

# JWT Secret
JWT_SECRET=student_management_super_secure_jwt_secret_change_in_production_2026
